pipeline {
  agent any

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region for the lab deployment')
    string(name: 'MY_IP_CIDR', defaultValue: 'YOUR_JENKINS_PUBLIC_IP/32', description: 'Public CIDR allowed to SSH and access OpenSearch')
    choice(name: 'ACTION', choices: ['apply', 'destroy'], description: 'Apply or destroy the OpenSearch lab stack')
  }

  environment {
    TF_VAR_aws_region = "${params.AWS_REGION}"
    TF_VAR_my_ip_cidr = "${params.MY_IP_CIDR}"
    TF_VAR_create_jenkins_instance = "false"
  }

  stages {
    stage('Tool Versions') {
      steps {
        sh 'terraform version'
        sh 'aws --version'
        sh 'ansible --version'
      }
    }

    stage('Terraform Init') {
      steps {
        sh 'terraform init'
      }
    }

    stage('Terraform Validate') {
      steps {
        sh 'terraform validate'
      }
    }

    stage('Terraform Apply') {
      when {
        expression { params.ACTION == 'apply' }
      }
      steps {
        sh 'terraform apply -auto-approve'
      }
    }

    stage('Install Ansible Collections') {
      when {
        expression { params.ACTION == 'apply' }
      }
      steps {
        dir('ansible') {
          sh 'ansible-galaxy collection install -r requirements.yml'
        }
      }
    }

    stage('Run Ansible') {
      when {
        expression { params.ACTION == 'apply' }
      }
      steps {
        dir('ansible') {
          sh 'ansible opensearch -m ping'
          sh 'ansible-playbook playbooks/install-opensearch.yml'
        }
      }
    }

    stage('Terraform Destroy') {
      when {
        expression { params.ACTION == 'destroy' }
      }
      steps {
        sh 'terraform destroy -auto-approve'
      }
    }
  }

  post {
    always {
      sh 'terraform output || true'
    }
  }
}
