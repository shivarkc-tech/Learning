aws_region = "us-east-1"

project_name       = "lab-opensearch"
vpc_cidr           = "10.50.0.0/16"
public_subnet_cidr = "10.50.1.0/24"
availability_zone  = null

# Replace this with your public IP in /32 CIDR format.
# Find it with: curl https://checkip.amazonaws.com
my_ip_cidr = "YOUR_PUBLIC_IP/32"

create_jenkins_instance = true

instance_type            = "t3.medium"
jenkins_instance_type    = "t3.medium"
root_volume_size         = 10
jenkins_root_volume_size = 20
data_volume_size         = 10
